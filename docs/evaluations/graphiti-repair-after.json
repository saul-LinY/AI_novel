            ]
          },
          {
            "id": "1cc385c1c0eed3055b10eab3721685a8048d34a8e1a03b82ef239b14ff8821e0",
            "kind": "perspective-report",
            "text": "上杉绘梨衣的认知记录：她刚写下下一站，他就掏出手机把位置发了出去，换的是她的药——她第一次看见他拿自己去换她活下去，而自己能做的只是站在下一级台阶上等",
            "sourceEventId": "0845fef7-a55f-46af-9b8c-9a904a9383e3",
            "source": "character-report:0",
            "ordinal": 3,
            "timeMinutes": 496,
            "view": "global",
            "score": -3.1312994956970215,
            "sourceOffset": 0,
            "truncated": false,
            "matchedTerms": [
              "自己",
              "记录"
            ],
            "retrievalSources": [
              "bm25",
              "graphiti"
            ]
          },
          {
            "id": "42b76fcde93901373842e48e637a914055d1404a53bf7b45af8e70a37b61aee9",
            "kind": "narrative",
            "text": "，跟压在自家房门上的那一个偏得一模一样。手机在口袋里贴着腿侧，那条回执的时间戳还像一块没凉透的烫铁。\n\n下到第一处平台，你停下来，翻开本子，把笔搁在上头，推给她。她没看你的眼睛，背靠着墙把本子按在膝上写，笔尖划得纸面发涩，握笔的手指还在抖，字迹比平时歪，写完就立刻合上，转手递给你——没让你代笔。纸上只有一行。头顶那扇消防门先响了一声，然后是脚步，一层一层顺着楼梯往下压。你把本子合上，手已经搭在底层那扇门的把手上。",
            "sourceEventId": "f3c5a1e3-26c3-42c1-a64d-8c037b85c3af",
            "source": "prose",
            "ordinal": 2,
            "timeMinutes": 493,
            "view": "global",
