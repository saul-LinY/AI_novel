flowchart LR
  cover["打开故事封面"] --> existing{"已有选定身份或存档"}
  existing -->|"是"| resume["继续当前路线"]
  existing -->|"否"| roles["预览可扮演角色"]
  cover -.->|"主动阅读序幕"| background["了解背景与眼前处境"]
  background --> comic["漫画呈现前情因果"]
  comic --> profiles["认识可扮演人物"]
  profiles --> npc["认识其他人物的公开身份"]
  npc --> roles
  roles --> compare["了解身份、优势、压力与行动立场"]
  compare --> confirm["确认扮演谁"]
  confirm --> setup["建立该角色的开局、关系、物品与已知信息"]
  setup --> opening["阅读预写的专属开场"]
  resume --> reading["阅读当前剧情"]
  opening --> reading
  reading --> act["选择建议行动或输入自己的行动"]
  reading -.->|"随时回看"| background
  npc -.-> boundary["引导只展示公开介绍；隐藏真相不随序幕公开"]
  classDef user fill:#C2E5FF,stroke:#3DADFF
  classDef good fill:#CDF4D3,stroke:#66D575
  classDef warn fill:#FFECBD,stroke:#FFC943
  class cover,roles,confirm,reading,act user
  class setup,opening good
  class boundary warn
