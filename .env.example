PORT=4317
HOST=0.0.0.0

# Optional. Defaults to ~/.pi/agent.
# PI_AGENT_DIR=/absolute/path/to/.pi/agent

# Optional model overrides. Defaults to pi-gateway/deepseek-v4-flash:cloud.
# PI_STORY_PROVIDER=pi-gateway
# PI_STORY_MODEL=deepseek-v4-flash:cloud

# Optional image gateway configuration for npm run imagegen.
# Keep real credentials only in .env; .env is ignored by Git.
SUB2API_BASE_URL=https://your-sub2api-gateway.example.com
SUB2API_API_KEY=replace-me
